<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YamAva.ViewModels"
             xmlns:conv="using:YamAva.ViewLogic"
             xmlns:convn="using:neXn.Ui.Avalonia.Converter"
             xmlns:local="using:YamAva.ViewElements"
             mc:Ignorable="d"
             x:DataType="local:WirelessDeviceElement"
             x:Class="YamAva.ViewElements.WirelessDeviceElement"
             x:Name="Root">

    <StackPanel Margin="12,0,0,8">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DeviceName, ElementName=Root, Converter={conv:LogitechNameConverter}}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EEEEEE" MaxWidth="42" MinWidth="42" Margin="0,0,8,0" Padding="0">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid IsVisible="{Binding IsDisconnected, Converter={convn:ReverseBoolConverter}, ElementName=Root}">
                <Image Source="{Binding DeviceIcon, ElementName=Root}" MaxHeight="36" />
                <Image Source="/Resources/Battery_dark.png" MaxHeight="36" />
                <Grid Width="11"
                      Height="19"
                      VerticalAlignment="Center"
                      ClipToBounds="True"
                      Margin="17,16,0,13">

                    <Border HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Height="{Binding BatteryPercentage,
                                             ElementName=Root,
                                             Converter={conv:BatteryHeightConverter},
                                             ConverterParameter=19}"
                            Background="{Binding BatteryPercentage,
                                                 ElementName=Root,
                                                 Converter={conv:BatteryColorConverter}}">
                    </Border>
                </Grid>
                <Image Source="/Resources/Charging.png" MaxHeight="36" IsVisible="{Binding IsCharging, ElementName=Root}" />
            </Grid>

            <Grid IsVisible="{Binding IsDisconnected, ElementName=Root}" MinHeight="36">
                <TextBlock Text="DISCONNECTED" FontSize="12" Foreground="WhiteSmoke" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{Binding BatteryPercentage, ElementName=Root, StringFormat={}{0} %}" FontSize="14" Margin="8,0,0,0" Foreground="WhiteSmoke" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDisconnected, Converter={convn:ReverseBoolConverter}, ElementName=Root}" />
        </StackPanel>
    </StackPanel>
</UserControl>
